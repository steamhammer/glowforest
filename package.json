{
  "name": "glowforest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply glowforest --local",
    "db:migrate:remote": "wrangler d1 migrations apply glowforest --remote",
    "index:import": "node scripts/import-index.mjs",
    "preinstall": "node scripts/ensure-pnpm.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "packageManager": "pnpm@11.22.0"
}
