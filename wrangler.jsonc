{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glowforest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glowforest",
      "database_id": "9916ba6f-b470-4fab-b5bc-63dacb11c61e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PREVIEWS",
      "bucket_name": "glowforest-previews"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "META_FRESHNESS_SECONDS": "604800",
    "STEAM_TIMEOUT_MS": "5000"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ]
}
